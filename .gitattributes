# Корневой сертификат в DER — двоичный файл. Его SHA-256 закреплён в
# bridge/transport.py, поэтому нормализация переводов строк сломала бы
# проверку якоря доверия.
*.cer binary

# Пакетные файлы Windows исполняет cmd.exe, а он спотыкается на переводах строк
# в стиле Unix: блоки if и метки перестают работать. Настройка git у оператора
# при клонировании может быть любой, поэтому перевод строк закреплён здесь.
*.cmd text eol=crlf
*.ps1 text eol=crlf
